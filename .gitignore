# Python
__pycache__/
*.pyc
.venv/

# 論文PDFと抽出テキスト（著作物のため同梱しない。内閣府サイトから取得）
reference/

# 調査用の一時ファイル
data/raw/_*
data/processed/_*

# 方程式リストから生成（src/parse_equations.py で再生成できる）
data/processed/equations.json

# ESRI から取得した統計表（src/fetch_sna.py で再取得できる）
data/raw/*.xlsx
# 財務省の国債の統計（data/raw/mof_jgb/）は、毎月更新されて同じ時点の版を再取得できないので同梱する
!data/raw/mof_jgb/*.xlsx
data/processed/baseline*.pkl
data/processed/variables.json

